# انسخ هذا الملف باسم .env وعدّل القيم (كلها اختيارية)
PORT=3000
# مكان ملف قاعدة البيانات والنسخ الاحتياطية (على ديسك دائم)
DB_PATH=./data/4seasons.db
BACKUP_DIR=./data/backups
# المنطقة الزمنية للمغسلة (تحدد "اليوم" في التقارير)
TZ_NAME=Africa/Cairo
# فعّلها true لو السيرفر خلف Nginx / Cloudflare / Render (لقراءة IP الحقيقي واكتشاف HTTPS)
TRUST_PROXY=false
# auto = تُفعَّل تلقائيًا مع HTTPS
COOKIE_SECURE=auto
# مدة الجلسة بالساعات (تتجدد مع الاستخدام)
SESSION_HOURS=12
# لو الموقع العام مستضاف على دومين مختلف عن النظام، اكتب دومينه هنا (مفصولة بفواصل)
# PUBLIC_ORIGINS=https://www.4seasons-laundry.com
# رابط الموقع العام النهائي (للـ canonical وsitemap)
# SITE_URL=https://www.4seasons-laundry.com
# أول رقم طلب
ORDER_START=1001

# (اختياري) إرسال كود تحقق "العميل السابق" تلقائيًا على واتساب/SMS.
# السيرفر بيبعت POST JSON: {event, phone, name, otp, expiresInMinutes, message} ومعاه Authorization: Bearer <TOKEN>.
# لو فاضي: الكود بيظهر في شاشة "طلبات الموقع" والكاشير يبعته للعميل بزر واتساب.
# OTP_WEBHOOK_URL=https://example.com/hooks/send-otp
# OTP_WEBHOOK_TOKEN=غيّر-القيمة-دي
